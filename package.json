{
  "name": "remelondb",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "pnpm -r build",
    "check:tutorial": "node scripts/check-tutorial.mjs",
    "check:readme": "node scripts/check-readme.mjs",
    "check:sync-tour": "node scripts/check-sync-tour.mjs",
    "check:backend-tutorial": "node scripts/check-backend-tutorial.mjs",
    "check:guide": "node scripts/check-codebase-guide.mjs",
    "check:wire": "node scripts/check-sync-wire.mjs",
    "check:reference": "node scripts/check-reference.mjs",
    "guide:epub": "pandoc docs/codebase-guide.md -o remelondb-guide.epub --toc --toc-depth=2 -N --resource-path=docs --css docs/codebase-guide.epub.css",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx}\" \"packages/*/e2e/**/*.{ts,tsx}\" \"examples/**/*.{ts,tsx}\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx}\" \"packages/*/e2e/**/*.{ts,tsx}\" \"examples/**/*.{ts,tsx}\" \"scripts/**/*.mjs\""
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "fast-check": "^4.9.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "react-dom": "^19.2.7",
    "tsdown": "^0.22.7",
    "typedoc": "^0.28.20",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "zod": "^4.4.3"
  },
  "license": "MIT",
  "version": "0.2.5"
}
