{
  "name": "@remelondb/store-drizzle",
  "version": "0.2.3",
  "type": "module",
  "dualFormat": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {},
  "peerDependencies": {
    "drizzle-orm": ">=0.40.0",
    "@remelondb/server": "workspace:*"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@remelondb/core": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0",
    "vitest": "^3.2.7",
    "@remelondb/server": "workspace:*"
  },
  "license": "MIT",
  "description": "remelonDB SyncStore for Postgres via drizzle-orm: config-per-table storage adapter satisfying the server store seam",
  "keywords": [
    "remelondb",
    "watermelondb",
    "drizzle",
    "postgres",
    "sync",
    "offline-first",
    "server"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dustyway/remelonDB.git",
    "directory": "packages/store-drizzle"
  },
  "homepage": "https://github.com/dustyway/remelonDB#readme",
  "bugs": "https://github.com/dustyway/remelonDB/issues",
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "prepack": "tsdown"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.mts",
          "default": "./dist/index.mjs"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    },
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/fixture.ts"
  ]
}
